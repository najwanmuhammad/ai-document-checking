{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5080"
      }
    }
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "StructuringModel": "openbmb/minicpm5-2b:latest",
    "TimeoutSeconds": 120
  },
  "Matching": {
    "TextFieldMatchThreshold": 0.9
  }
}
