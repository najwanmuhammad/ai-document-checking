{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5080"
      }
    }
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "StructuringModel": "openbmb/minicpm5-2b:latest",
    "TimeoutSeconds": 120,
    "KeepAlive": "2m",
    "Seed": 42,
    "NumPredict": 1200,
    "NumContext": 8192,
    "NumThread": 4
  },
  "Ocr": {
    "MaximumFileSizeBytes": 20971520,
    "PdfDpi": 300,
    "EnableColorContrastPass": true,
    "ColorPassConfidenceThreshold": 0.92
  },
  "Cleaning": {
    "ReviewThreshold": 0.85
  },
  "Matching": {
    "TextFieldMatchThreshold": 0.9
  }
}
